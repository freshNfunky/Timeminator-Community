# Local configuration with credentials
/config.php

# Local SQLite database + any data artifacts
/data/*.sqlite
/data/*.sqlite-journal
/data/*.sqlite-wal
/data/*.sqlite-shm
/data/*.sqlite.bak*
/data/*.bak*

# Runtime state written under data/ (settings, feed caches, logs)
/data/*.json
/data/*.log

# OS / editor cruft
.DS_Store
*.swp
Thumbs.db

# Test tooling — kept out of the release so the ship stays Composer-free.
/phpunit.phar
/.phpunit.cache/
/.phpunit.result.cache
/phpunit.xml
/vendor/
/composer.lock
